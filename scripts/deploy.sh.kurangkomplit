#!/bin/bash

TIMESTAMP=$(date +%F-%H%M%S)

DEPLOY_ID="DEPLOY-${TIMESTAMP}"

LOGFILE="logs/deployments/${DEPLOY_ID}.log"

METAFILE="logs/metadata/${DEPLOY_ID}.txt"

REPORTFILE="logs/reports/${DEPLOY_ID}.txt"

START=$(date +%s)

ansible-playbook "$@" 2>&1 | tee "$LOGFILE"

RESULT=${PIPESTATUS[0]}

END=$(date +%s)

DURATION=$((END-START))

echo "Deployment ID : $DEPLOY_ID" > "$METAFILE"
echo "Timestamp     : $(date)" >> "$METAFILE"
echo "Operator      : $(whoami)" >> "$METAFILE"
echo "Controller    : $(hostname)" >> "$METAFILE"
echo "Playbook      : $1" >> "$METAFILE"
echo "Duration      : ${DURATION}s" >> "$METAFILE"
echo "Result        : $RESULT" >> "$METAFILE"

echo
echo "Log saved:"
echo "$LOGFILE"

echo
echo "Metadata saved:"
echo "$METAFILE"
